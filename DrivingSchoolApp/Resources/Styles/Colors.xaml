<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Soft light palette matching the login mockup -->
    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand / action colors -->
    <Color x:Key="Primary">#2F6FD6</Color>
    <Color x:Key="PrimaryDark">#245FC0</Color>
    <Color x:Key="PrimaryDarkText">#1F1F1F</Color>
    <Color x:Key="Secondary">#F3F3F3</Color>
    <Color x:Key="SecondaryDarkText">#7A7A7A</Color>
    <Color x:Key="Tertiary">#E9EEF8</Color>

    <!-- Base colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#111111</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#1F2A44</Color>
    <Color x:Key="OffBlack">#2A2A2A</Color>

    <!-- Neutral grays tuned to the mockup -->
    <Color x:Key="Gray100">#F7F7F7</Color>
    <Color x:Key="Gray200">#EFEFEF</Color>
    <Color x:Key="Gray300">#E2E2E2</Color>
    <Color x:Key="Gray400">#CFCFCF</Color>
    <Color x:Key="Gray500">#A8A8A8</Color>
    <Color x:Key="Gray600">#7E7E7E</Color>
    <Color x:Key="Gray700">#5F5F5F</Color>
    <Color x:Key="Gray900">#2B2B2B</Color>
    <Color x:Key="Gray950">#1A1A1A</Color>

    <!-- Extra useful colors for this design -->
    <Color x:Key="PageBackground">#F2F2F2</Color>
    <Color x:Key="CardBackground">#F6F6F6</Color>
    <Color x:Key="InputBackground">#ECECEC</Color>
    <Color x:Key="InputBorder">#DDDDDD</Color>
    <Color x:Key="PlaceholderText">#9A9A9A</Color>
    <Color x:Key="LinkText">#6F9FE8</Color>
    <Color x:Key="ShadowColor">#18000000</Color>

    <!-- Semantic UI colors used where pages override the default control styles -->
    <Color x:Key="PrimaryTextLight">#111111</Color>
    <Color x:Key="PrimaryTextDark">#FFFFFF</Color>
    <Color x:Key="SecondaryTextLight">#5F5F5F</Color>
    <Color x:Key="SecondaryTextDark">#E2E2E2</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#2B2B2B</Color>
    <Color x:Key="SelectedSurfaceLight">#E9EEF8</Color>
    <Color x:Key="SelectedSurfaceDark">#245FC0</Color>
    <Color x:Key="ChromeBackground">#2F6FD6</Color>
    <Color x:Key="ChromeForeground">#FFFFFF</Color>
    <Color x:Key="ChromeUnselected">#DCE7FB</Color>
    <Color x:Key="ActiveRouteChromeBackground">#2F9B63</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackground}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackground}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorder}" />
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="{StaticResource PlaceholderText}" />
    <SolidColorBrush x:Key="LinkTextBrush" Color="{StaticResource LinkText}" />
    <SolidColorBrush x:Key="ShadowColorBrush" Color="{StaticResource ShadowColor}" />
</ResourceDictionary>
