<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DrivingSchoolApp.Pages.TrackingPage"
             Title="Tracking">

    <Grid Padding="16"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          RowSpacing="10">

        <Label Grid.Row="0" Text="GPS Tracking (v1)" FontSize="20" />
        <Label Grid.Row="1" x:Name="StatusLabel" Text="Status: idle" />

        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Button Text="Start" Clicked="Start_Clicked" />
            <Button Text="Stop" Clicked="Stop_Clicked" />
            <Button Text="Clear" Clicked="Clear_Clicked" />
        </HorizontalStackLayout>

        <Label Grid.Row="3" x:Name="CountLabel" Text="Points: 0" />

        <CollectionView Grid.Row="4"
                        x:Name="PointsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8">
                        <Label Text="{Binding Timestamp}" FontSize="12" />
                        <Label Text="{Binding Latitude, StringFormat='Lat: {0:F6}'}" />
                        <Label Text="{Binding Longitude, StringFormat='Lng: {0:F6}'}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>