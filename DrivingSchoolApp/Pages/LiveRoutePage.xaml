<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DrivingSchoolApp.Pages.LiveRoutePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    Title="Route"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid>
        <mapsui:MapView
            x:Name="RouteMapView"
            IsZoomButtonVisible="True"
            IsMyLocationButtonVisible="False" />

        <Grid Padding="16">
            <Border
                VerticalOptions="End"
                BackgroundColor="#F7FFFFFF"
                Stroke="{StaticResource InputBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="14">

                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="HeroElapsedLabel"
                        Text="00:00"
                        FontSize="34"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Black}" />

                    <Button
                        x:Name="RecenterButton"
                        Text="Center"
                        Clicked="RecenterButton_Clicked"
                        HorizontalOptions="Center"
                        BackgroundColor="{StaticResource White}"
                        TextColor="{StaticResource Black}"
                        IsVisible="False" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Button
                            x:Name="StartButton"
                            Grid.Column="0"
                            Text="Start"
                            Clicked="StartButton_Clicked" />

                        <Button
                            x:Name="StopButton"
                            Grid.Column="1"
                            Text="Stop"
                            Clicked="StopButton_Clicked" />

                        <Button
                            x:Name="EndButton"
                            Grid.Column="2"
                            Text="End"
                            Clicked="EndButton_Clicked" />

                        <Button
                            x:Name="ResetButton"
                            Grid.Column="3"
                            Text="Reset"
                            Clicked="ResetButton_Clicked"
                            BackgroundColor="{StaticResource Gray300}"
                            TextColor="{StaticResource Black}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid
            x:Name="FirstFixOverlay"
            BackgroundColor="#66000000"
            IsVisible="False"
            InputTransparent="False">

            <Border
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="280"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="True"
                        Color="{StaticResource Primary}"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Waiting for first GPS point"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Black}" />

                    <Label
                        Text="Keep the app open for a moment while the phone gets a valid location fix."
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>