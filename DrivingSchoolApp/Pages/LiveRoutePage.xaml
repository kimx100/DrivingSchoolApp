<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DrivingSchoolApp.Pages.LiveRoutePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    xmlns:text="clr-namespace:DrivingSchoolApp.Localization"
    Title="{x:Static text:AppText.LiveRoutePageTitle}"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid>
        <mapsui:MapView
            x:Name="RouteMapView"
            IsZoomButtonVisible="True"
            IsMyLocationButtonVisible="False" />

        <Grid
            Padding="16"
            RowDefinitions="*,Auto,Auto"
            RowSpacing="10">
            <Button
                x:Name="RecenterButton"
                Grid.Row="1"
                Text="{x:Static text:AppText.LiveCenterButton}"
                Clicked="RecenterButton_Clicked"
                HorizontalOptions="End"
                WidthRequest="96"
                HeightRequest="44"
                Padding="12,0"
                CornerRadius="22"
                BackgroundColor="{StaticResource White}"
                BorderColor="#D6D6D6"
                BorderWidth="1"
                TextColor="{StaticResource Black}"
                IsVisible="False" />

            <Border
                Grid.Row="2"
                VerticalOptions="End"
                BackgroundColor="#F7FFFFFF"
                Stroke="#D6D6D6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="14">

                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="HeroElapsedLabel"
                        Text="00:00"
                        FontSize="34"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Black}" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Button
                            x:Name="StartButton"
                            Grid.Column="0"
                            Text="{x:Static text:AppText.LiveStartButton}"
                            Clicked="StartButton_Clicked" />

                        <Button
                            x:Name="StopButton"
                            Grid.Column="1"
                            Text="{x:Static text:AppText.LiveStopButton}"
                            Clicked="StopButton_Clicked" />

                        <Button
                            x:Name="EndButton"
                            Grid.Column="2"
                            Text="{x:Static text:AppText.LiveEndButton}"
                            Clicked="EndButton_Clicked" />

                        <Button
                            x:Name="ResetButton"
                            Grid.Column="3"
                            Text="{x:Static text:AppText.LiveResetButton}"
                            Clicked="ResetButton_Clicked"
                            BackgroundColor="{StaticResource Gray300}"
                            TextColor="{StaticResource Black}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid
            x:Name="FirstFixOverlay"
            BackgroundColor="#66000000"
            IsVisible="False"
            InputTransparent="False">

            <Border
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="280"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="True"
                        Color="{StaticResource Primary}"
                        HorizontalOptions="Center" />

                    <Label
                        Text="{x:Static text:AppText.LiveWaitingForGpsTitle}"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Black}" />

                    <Label
                        Text="{x:Static text:AppText.LiveWaitingForGpsMessage}"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
