<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DrivingSchoolApp.Pages.RouteDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    xmlns:text="clr-namespace:DrivingSchoolApp.Localization"
    Title="{x:Static text:AppText.RouteDetailPageTitle}"
    BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            x:Name="SnapToolbarItem"
            Text="{x:Static text:AppText.RouteDetailSnapButton}"
            Order="Primary"
            Clicked="SnapToolbarItem_Clicked" />

        <ToolbarItem
            Text="{x:Static text:AppText.RouteDetailDeleteButton}"
            Order="Primary"
            Clicked="DeleteToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <mapsui:MapView
            x:Name="RouteMapView"
            IsZoomButtonVisible="True"
            IsMyLocationButtonVisible="False" />

        <Grid
            x:Name="LoadingOverlay"
            BackgroundColor="#66000000"
            IsVisible="True"
            InputTransparent="False">

            <Border
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="240"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource InputBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="20">

                <VerticalStackLayout Spacing="10">
                    <ActivityIndicator
                        IsRunning="True"
                        Color="{StaticResource Primary}"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="LoadingMessageLabel"
                        Text="{x:Static text:AppText.RouteDetailLoadingMessage}"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Black}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
