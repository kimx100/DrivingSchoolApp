<ContentPage
    x:Class="DrivingSchoolApp.Pages.LogInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:text="clr-namespace:DrivingSchoolApp.Localization"
    Title="{x:Static text:AppText.LoginPageTitle}"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid Padding="24">
        <Grid.Background>
            <SolidColorBrush Color="{StaticResource PageBackground}" />
        </Grid.Background>

        <Border
            Stroke="{StaticResource InputBorder}"
            StrokeShape="RoundRectangle 24"
            Padding="28"
            VerticalOptions="Center"
            HorizontalOptions="Fill"
            BackgroundColor="{StaticResource White}"
            StrokeThickness="1">
            <Border.Shadow>
                <Shadow
                    Brush="{StaticResource ShadowColorBrush}"
                    Offset="0,8"
                    Radius="18"
                    Opacity="0.35" />
            </Border.Shadow>
            <VerticalStackLayout x:Name="LoginFormLayout" Spacing="16">
                <Label Text="{x:Static text:AppText.LoginHeader}"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Black}" />

                <Entry Placeholder="{x:Static text:AppText.LoginEmailPlaceholder}"
                       Keyboard="Email"
                       Text="{Binding Username}"
                       HorizontalOptions="Fill"
                       TextColor="{StaticResource Black}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="{StaticResource White}" />

                <Entry Placeholder="{x:Static text:AppText.LoginPasswordPlaceholder}"
                       IsPassword="True"
                       Text="{Binding Password}"
                       HorizontalOptions="Fill"
                       TextColor="{StaticResource Black}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="{StaticResource White}" />

                <Button Text="{x:Static text:AppText.LoginButton}"
                        Command="{Binding LoginCommand}"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Label Text="{x:Static text:AppText.LoginForgotPassword}"
                           FontSize="12"
                           TextColor="{StaticResource PrimaryDark}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
