<ContentPage
    x:Class="DrivingSchoolApp.Pages.LogInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid Padding="24">
        <Grid.Background>
            <SolidColorBrush Color="{StaticResource PageBackground}" />
        </Grid.Background>

        <Border
            Stroke="{StaticResource InputBorder}"
            StrokeShape="RoundRectangle 24"
            Padding="28"
            VerticalOptions="Center"
            HorizontalOptions="Fill"
            BackgroundColor="{StaticResource White}"
            StrokeThickness="1">
            <Border.Shadow>
                <Shadow
                    Brush="#40000000"
                    Offset="0,8"
                    Radius="18"
                    Opacity="0.35" />
            </Border.Shadow>
            <VerticalStackLayout
                x:Name="LoginFormLayout"
                Spacing="16">
                <Label Text="Log ind"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Black}" />

                <Entry Placeholder="Email"
                       Keyboard="Email"
                       Text="{Binding Username}"
                       HorizontalOptions="Fill"
                       TextColor="{StaticResource Black}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="{StaticResource White}" />

                <Entry Placeholder="Password"
                       IsPassword="True"
                       Text="{Binding Password}"
                       HorizontalOptions="Fill"
                       TextColor="{StaticResource Black}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="{StaticResource White}" />

                <Button Text="Log ind"
                        Command="{Binding LoginCommand}"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Label Text="Forgot password?"
                           FontSize="12"
                           TextColor="{StaticResource PrimaryDark}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
