<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="DrivingSchoolApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DrivingSchoolApp.Pages"
    xmlns:text="clr-namespace:DrivingSchoolApp.Localization"
    Title="DrivingSchoolApp">

    <TabBar>
        <ShellContent
            Route="live-route"
            Title="{x:Static text:AppText.ShellRouteTabTitle}"
            ContentTemplate="{DataTemplate pages:LiveRoutePage}" />

        <ShellContent
            Route="saved-routes"
            Title="{x:Static text:AppText.ShellSavedTabTitle}"
            ContentTemplate="{DataTemplate pages:SavedRoutesPage}" />

        <ShellContent
            Route="theory"
            Title="Theory"
            ContentTemplate="{DataTemplate pages:TheoryLessonPage}" />
    </TabBar>
</Shell>
