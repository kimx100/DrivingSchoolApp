<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="DrivingSchoolApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:DrivingSchoolApp.Pages"
    Title="DrivingSchoolApp">

    <TabBar>
        <ShellContent
            Title="Theory"
            ContentTemplate="{DataTemplate pages:TheoryLessonPage}" />

        <ShellContent
            Title="Route"
            ContentTemplate="{DataTemplate pages:LiveRoutePage}" />

        <ShellContent
            Title="Saved"
            ContentTemplate="{DataTemplate pages:SavedRoutesPage}" />
    </TabBar>
</Shell>
